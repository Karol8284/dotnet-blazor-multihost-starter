<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StarterProjectDirectoryName>$([System.IO.Path]::GetFileName('$(MSBuildProjectDirectory)'))</StarterProjectDirectoryName>
    <StarterProjectName>$([System.Text.RegularExpressions.Regex]::Replace('$(StarterProjectDirectoryName)', '\.(Web\.Client|Api\.IntegrationTests|Application\.Tests|Domain\.Tests|Shared\.Tests|Infrastructure|Application|Contracts|Domain|Client|Shared|Maui|Web)$', ''))</StarterProjectName>
    <StarterSafeProjectName>$([System.Text.RegularExpressions.Regex]::Replace('$(StarterProjectName)', '\W', '_'))</StarterSafeProjectName>
  </PropertyGroup>
</Project>
