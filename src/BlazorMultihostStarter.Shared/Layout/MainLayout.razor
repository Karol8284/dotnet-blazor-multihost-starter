@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <a class="brand" href="/">Blazor Multihost Starter</a>
        <nav class="mode-nav" aria-label="Task data modes">
            <a href="/">Server-centric</a>
            <a href="/tasks/local">Client-local</a>
            <a href="/tasks/offline">Offline hybrid</a>
        </nav>
        <span class="host-label">Web · MAUI</span>
    </header>

    <main class="app-main">
        @Body
    </main>

    <footer class="app-footer">
        One shared Razor UI. Choose the data mode that fits the feature.
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    The UI encountered an unexpected error.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">Dismiss</span>
</div>
