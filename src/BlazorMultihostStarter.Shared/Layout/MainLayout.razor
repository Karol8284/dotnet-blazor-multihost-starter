@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <a class="brand" href="/">Blazor Multihost Starter</a>
        <span class="host-label">Web · MAUI</span>
    </header>

    <main class="app-main">
        @Body
    </main>

    <footer class="app-footer">
        One shared Razor UI. Two hosts. One API.
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    The UI encountered an unexpected error.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">Dismiss</span>
</div>
