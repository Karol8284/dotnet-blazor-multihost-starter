<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>$(StarterSafeProjectName).Web</AssemblyName>
    <UserSecretsId>__WEB_USER_SECRETS_ID__</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\$(StarterProjectName).Web.Client\$(StarterProjectName).Web.Client.csproj" />
    <ProjectReference Include="..\$(StarterProjectName).Shared\$(StarterProjectName).Shared.csproj" />
    <ProjectReference Include="..\$(StarterProjectName).Application\$(StarterProjectName).Application.csproj" />
    <ProjectReference Include="..\$(StarterProjectName).Contracts\$(StarterProjectName).Contracts.csproj" />
    <ProjectReference Include="..\$(StarterProjectName).Infrastructure\$(StarterProjectName).Infrastructure.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
  </ItemGroup>

</Project>